{
  "name": "backend",
  "version": "0.1.0",
  "description": "Simple NestJS app",
  "main": "dist/main.js",
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "start": "node dist/main.js",
    "start:remote": "SECRETS_SOURCE=infisical node --env-file=.env dist/main.js",
    "start:dev": "ts-node src/main.ts",
    "start:dev:remote": "SECRETS_SOURCE=infisical node --env-file=.env -r ts-node/register src/main.ts",
    "typeorm": "node --env-file=.env -r ts-node/register ./node_modules/typeorm/cli.js -d src/data-source.ts",
    "migration:generate": "pnpm run typeorm migration:generate",
    "migration:run": "node --env-file=.env -r ts-node/register src/migration-runner.ts run",
    "migration:run:remote": "SECRETS_SOURCE=infisical node --env-file=.env -r ts-node/register src/migration-runner.ts run",
    "migration:revert": "node --env-file=.env -r ts-node/register src/migration-runner.ts revert",
    "migration:revert:remote": "SECRETS_SOURCE=infisical node --env-file=.env -r ts-node/register src/migration-runner.ts revert",
    "seed:dev": "node --env-file=.env -r ts-node/register src/seed-runner.ts",
    "seed:dev:remote": "SECRETS_SOURCE=infisical node --env-file=.env -r ts-node/register src/seed-runner.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1009.0",
    "@infisical/sdk": "^5.0.2",
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^10.3.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/typeorm": "^10.0.0",
    "csv-parse": "^6.1.0",
    "jwks-rsa": "^4.1.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@types/node": "^20.11.5",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.18.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "vitest": "^4.1.9"
  }
}
