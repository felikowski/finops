# Where the app reads its secrets from at startup:
#   local     → read this .env file (default)
#   infisical → fetch from the Infisical instance and inject into the environment
SECRETS_SOURCE=local

DB_HOST=localhost
DB_PORT=5432
DB_USER=finops_owner
DB_PASSWORD=postgres
DB_NAME=finops
DB_SCHEMA=finops

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Infisical — only required when SECRETS_SOURCE=infisical.
# INFISICAL_CLIENT_ID / INFISICAL_CLIENT_SECRET are the machine-identity
# credentials ("secret zero") and must be supplied via the environment.
INFISICAL_SITE_URL=https://your-infisical-instance
INFISICAL_PROJECT_ID=
INFISICAL_ENVIRONMENT=prod
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
INFISICAL_SECRET_PATH=/