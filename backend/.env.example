# Where the app reads its secrets from at startup:
#   local     → read this .env file (default)
#   infisical → fetch from the Infisical instance and inject into the environment
SECRETS_SOURCE=local

# In local mode these are read from here (or fall back to app.module defaults).
# When SECRETS_SOURCE=infisical, ALL of the DB_* values below are overwritten
# from Infisical: connection info (host/port/database/schema) from /postgres,
# and DB_USER/DB_PASSWORD from /postgres/finops/finops_owner. The values below
# are just the local defaults.
DB_HOST=localhost
DB_PORT=5432
DB_USER=finops_owner
DB_PASSWORD=postgres
DB_NAME=finops
DB_SCHEMA=finops

# Global fallback AWS identity, used only for billing accounts that don't set
# their own `credentialRef` (billing_accounts registry, issue #16). Region is
# NOT read from here anymore — each billing account carries its own
# sourceConfig.region, resolved at pull time.
# When SECRETS_SOURCE=infisical, both are overwritten from Infisical
# (keys "access_key_id"/"secret_access_key" at /aws/finops/billing-s3-reader).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Infisical — only required when SECRETS_SOURCE=infisical.
# INFISICAL_CLIENT_ID / INFISICAL_CLIENT_SECRET are the machine-identity
# credentials ("secret zero") and must be supplied via the environment.
# INFISICAL_ENVIRONMENT is the environment *slug* in Infisical (the default
# Development environment's slug is "dev", not "development").
# The paths/keys the app fetches are declared in secrets.bootstrap.ts; see
# docs/infisical.md for the full required vault structure.
INFISICAL_SITE_URL=https://your-infisical-instance
INFISICAL_PROJECT_ID=
INFISICAL_ENVIRONMENT=dev
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
